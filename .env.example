# copy to .env and fill in. .env is gitignored, never commit real keys.

# ---------------------------------------------------------------------------
# DagsHub. One free account gives you a DVC remote and a hosted MLflow server,
# so there is no bucket to create and no mlflow process to run locally.
# Get these from your repo page on dagshub.com, under the "Remote" button.
# ---------------------------------------------------------------------------
DAGSHUB_USER=
DAGSHUB_REPO=nastaliq-ops
DAGSHUB_TOKEN=

MLFLOW_TRACKING_URI=https://dagshub.com/${DAGSHUB_USER}/${DAGSHUB_REPO}.mlflow
MLFLOW_TRACKING_USERNAME=${DAGSHUB_USER}
MLFLOW_TRACKING_PASSWORD=${DAGSHUB_TOKEN}
MLFLOW_EXPERIMENT=nastaliq-ops

# ---------------------------------------------------------------------------
# If you would rather use S3 directly, leave the DagsHub block blank, set
# MLFLOW_TRACKING_URI to http://localhost:5000 and fill these in instead.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# ---------------------------------------------------------------------------
# LLM provider for the corrector agent and the judge. Groq's free tier is
# enough for this project and needs no card.
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Langfuse for prompt versioning and agent tracing. Optional. The code runs
# without it, it just stops tracing. Free cloud tier at cloud.langfuse.com.
# ---------------------------------------------------------------------------
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
